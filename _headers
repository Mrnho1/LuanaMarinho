# Cloudflare Pages — cabeçalhos de segurança e cache.
# Ver https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# O HTML precisa ser revalidado para que uma publicação nova apareça na hora.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Assets são versionados por querystring (?v=) ou imutáveis por natureza.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/styles/*
  Cache-Control: public, max-age=604800

/scripts/*
  Cache-Control: public, max-age=604800
